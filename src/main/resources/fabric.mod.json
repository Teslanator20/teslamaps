{
    "schemaVersion": 1,
    "id": "teslamaps",
    "version": "${version}",
    "name": "TeslaMaps",
    "description": "Dungeon map overlay and utilities for Hypixel Skyblock",
    "authors": ["Tesla"],
    "license": "GPL-3.0-or-later",
    "contact": {},
    "environment": "client",
    "entrypoints": {
        "client": ["com.teslamaps.TeslaMaps"],
        "preLaunch": ["com.teslamaps.AwtHeadless"],
        "modmenu": ["com.teslamaps.compat.ModMenuIntegration"]
    },
    "mixins": ["teslamaps.mixins.json", "teslamaps-adm-misc.mixins.json", "teslamaps-adm-map.mixins.json",
        "teslamaps-adm-leap.mixins.json", "teslamaps-adm-practice.mixins.json",
        "teslamaps-adm-sim.mixins.json"],
    "accessWidener": "teslamaps.accesswidener",
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "fabric-api": "*"
    }
}
